{
  "name": "aeromind-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:pix && npm run test:plans && npm run test:licenses && npm run test:admin && npm run test:customer && npm run test:devices && npm run test:notices && npm run test:mobile-nav && npm run test:landing && npm run test:trial && npm run test:gold && npm run test:gold-simulator && npm run test:gold-plans && npm run test:gold-entitlements && next build",
    "test:pix": "node --experimental-strip-types --test tests/pix-security.test.mjs",
    "start": "next start",
    "test:plans": "node --experimental-strip-types --test tests/plan-editor.test.mjs",
    "test:licenses": "node --experimental-strip-types --test tests/license-expiry.test.mjs",
    "test:admin": "node --test tests/admin-structure.test.mjs",
    "test:customer": "node --experimental-strip-types --test tests/customer-v3.test.mjs",
    "test:devices": "node --test tests/device-activity.test.mjs",
    "test:notices": "node --test tests/notification-center.test.mjs",
    "test:mobile-nav": "node --test tests/admin-mobile-navigation.test.mjs",
    "test:landing": "node --test tests/landing-design.test.mjs",
    "test:trial": "node --test tests/free-trial-premium.test.mjs",
    "test:gold": "node --experimental-strip-types --test tests/gold-foundation.test.mjs",
    "test:gold-simulator": "node --experimental-strip-types --test tests/gold-simulator.test.mjs",
    "test:gold-plans": "node --test tests/gold-plan-card.test.mjs",
    "test:gold-entitlements": "node --experimental-strip-types --test tests/gold-entitlements.test.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "@types/qrcode": "^1.5.5"
  }
}
